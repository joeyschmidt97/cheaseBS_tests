    "from collections import defaultdict\n",
    "\n",
    "def get_params(sim):\n",
    "    return (\n",
    "        float(sim['kymin'].values),\n",
    "        int(sim['nz0'].values),\n",
    "        int(sim['nv0'].values),\n",
    "        int(sim['nx0'].values),\n",
    "    )\n",
    "\n",
    "# Print all param sets to see what's actually there\n",
    "for sim in gene_sims_list:\n",
    "    print(sim.attrs.get('filepath', 'unknown'), '->', get_params(sim))\n",
    "\n",
    "# Show group sizes\n",
    "groups = defaultdict(list)\n",
    "for sim in gene_sims_list:\n",
    "    groups[get_params(sim)].append(sim)\n",
    "\n",
    "print(\"\\nGroup sizes:\")\n",
    "for params, sims in groups.items():\n",
    "    print(f\"  {params} -> {len(sims)} sim(s)\")"
   ]
