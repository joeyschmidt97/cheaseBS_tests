   "source": [
    "from collections import defaultdict\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "KYMIN_TOL = 0.02  # adjust if needed\n",
    "\n",
    "def find_kymin_matches(gene_sims_list, tol=KYMIN_TOL):\n",
    "    \"\"\"Group sims by close kymin + exact nz0, nv0, nx0.\"\"\"\n",
    "    unmatched = list(gene_sims_list)\n",
    "    groups = []\n",
    "\n",
    "    while unmatched:\n",
    "        ref = unmatched.pop(0)\n",
    "        ref_ky = float(ref['kymin'].values)\n",
    "        ref_nz = int(ref['nz0'].values)\n",
    "        ref_nv = int(ref['nv0'].values)\n",
    "        ref_nx = int(ref['nx0'].values)\n",
    "\n",
    "        group = [ref]\n",
    "        remaining = []\n",
    "        for sim in unmatched:\n",
    "            ky = float(sim['kymin'].values)\n",
    "            nz = int(sim['nz0'].values)\n",
    "            nv = int(sim['nv0'].values)\n",
    "            nx = int(sim['nx0'].values)\n",
    "\n",
    "            if (abs(ky - ref_ky) <= tol and nz == ref_nz\n",
    "                    and nv == ref_nv and nx == ref_nx):\n",
    "                group.append(sim)\n",
    "            else:\n",
    "                remaining.append(sim)\n",
    "\n",
    "        unmatched = remaining\n",
    "        if len(group) >= 2:\n",
    "            groups.append(group)\n",
    "\n",
    "    return groups\n",
    "\n",
    "\n",
    "groups = find_kymin_matches(gene_sims_list)\n",
    "print(f\"Found {len(groups)} matched groups\")\n",
    "for g in groups:\n",
    "    print(f\"  kymin~{[round(float(s['kymin'].values), 4) for s in g]}, nz0={int(g[0]['nz0'].values)}\")\n",
    "\n",
    "# Plot each group as subplots\n",
    "for group in groups:\n",
    "    n = len(group)\n",
    "    fig, axes = plt.subplots(1, n, figsize=(7 * n, 5), sharey=True)\n",
    "    if n == 2:\n",
    "        axes = list(axes)  # ensure iterable\n",
    "\n",
    "    mean_ky = np.mean([float(s['kymin'].values) for s in group])\n",
    "    nz0 = int(group[0]['nz0'].values)\n",
    "    nv0 = int(group[0]['nv0'].values)\n",
    "    nx0 = int(group[0]['nx0'].values)\n",
    "    fig.suptitle(f'kymin≈{mean_ky:.4f}, nz0={nz0}, nv0={nv0}, nx0={nx0}',\n",
    "                 fontsize=13, fontweight='bold')\n",
    "\n",
    "    for ax, sim in zip(axes, group):\n",
    "        zgrid = sim['zgrid'].values\n",
    "        field_phi = sim['field_phi'].values[-1]\n",
    "\n",
    "        ax.plot(zgrid, np.real(field_phi), label='Real')\n",
    "        ax.plot(zgrid, np.imag(field_phi), label='Imaginary')\n",
    "        ax.plot(zgrid, np.abs(field_phi),  label='Magnitude')\n",
    "\n",
    "        filepath = sim.attrs.get('filepath', 'unknown')\n",
    "        # Show scanfiles folder + param file as title\n",
    "        parts = filepath.split('/')\n",
    "        short = '/'.join(parts[-3:])  # e.g. chease_modded/scanfiles0000/parameters_0003\n",
    "        omega = sim['omega'].values if 'omega' in sim else 'N/A'\n",
    "        ax.set_title(f'{short}\\nky={float(sim[\"kymin\"].values):.5f}, ω={omega} field_time={sim[\"field_time\"].values[-1]}', fontsize=8)\n",
    "        ax.set_xlabel('zgrid')\n",
    "        ax.set_ylabel('field_phi')\n",
    "        ax.legend(fontsize=8)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
